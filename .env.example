# Copy this file to .env.local and fill in real values.
# See README.md for full setup instructions.

# ── Supabase ──────────────────────────────────────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ── Edge Function secrets (set via `supabase secrets set`, not here) ──────────
# AUDD_API_TOKEN        — audio fingerprinting, sign up at https://audd.io
# ANTHROPIC_API_KEY     — frame OCR (Claude Haiku), from https://console.anthropic.com
#
#   supabase secrets set AUDD_API_TOKEN=<your-token>
#   supabase secrets set ANTHROPIC_API_KEY=<your-key>
